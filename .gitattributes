# Unity сериализует сцены и префабы в текст — без этого git считает
# их бинарными и не показывает изменения.
*.cs                text diff=csharp
*.unity             text merge=unityyamlmerge eol=lf
*.prefab            text merge=unityyamlmerge eol=lf
*.asset             text merge=unityyamlmerge eol=lf
*.meta              text merge=unityyamlmerge eol=lf
*.mat               text merge=unityyamlmerge eol=lf
*.anim              text merge=unityyamlmerge eol=lf
*.controller        text merge=unityyamlmerge eol=lf
*.physicMaterial    text merge=unityyamlmerge eol=lf
*.asmdef            text eol=lf
*.uxml              text eol=lf
*.uss               text eol=lf
*.json              text eol=lf
*.inputactions      text eol=lf
*.shadergraph       text eol=lf
*.shader            text eol=lf

# Бинарные ассеты
*.png               binary
*.jpg               binary
*.jpeg              binary
*.tga               binary
*.exr               binary
*.hdr               binary
*.fbx               binary
*.glb               binary
*.blend             binary
*.wav               binary
*.ogg               binary
*.mp3               binary
*.ttf               binary
*.otf               binary
