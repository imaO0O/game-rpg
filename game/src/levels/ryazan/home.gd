## Рязань, дом. Первая комната игры (DESIGN.md §9).
##
## Здесь ничего не гейтится и ничего нельзя пропустить: задача комнаты —
## научить бегать и прыгать, ничего об этом не говоря. Единственный осколок
## лежит на виду, чтобы игрок понял, что осколки вообще бывают.
extends Room

const YARD := "res://src/levels/ryazan/yard.tscn"


func _define() -> void:
	room_id = "ryazan_home"
	room_title = "Рязань"

	bounds(0, 0, 30, 20)

	# Пол, потолок, стены.
	block(0, 16, 30, 4)
	block(0, 0, 30, 2)
	block(0, 2, 1, 14)
	block(29, 2, 1, 14)

	# Мебель, она же первые платформы. Прыгать придётся, но промахнуться
	# некуда — под ними ровный пол.
	block(7, 13, 4, 1)
	block(13, 10, 4, 1)
	block(19, 12, 3, 1)

	spawn("start", 3, 16)
	# Возврат со двора — к своей двери, а не в начало комнаты.
	# Не вплотную: иначе игрок появится внутри двери и уйдёт обратно.
	spawn("east", 25, 16)

	# Пинки заговаривает сама — первое, что происходит в игре.
	dialogue(5, 16, "ryazan_home_intro", "Пинки", true)

	# Осколок на средней платформе: виден снизу, требует одного прыжка.
	shard(14, 10, "ryazan_01", "Дом")

	door(28, 16, YARD, "west")
